# Supabase (accounts + cloud sync). The publishable/anon key is safe to expose;
# row-level security protects the data. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Claude-powered assist (server-side only). Leave blank to disable.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_ASSIST=1
