# Supabase (accounts + cloud sync). The publishable/anon key is safe to expose;
# row-level security protects the data. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Claude-powered assist (server-side only). Leave blank to disable.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_ASSIST=1

# AI speaking partner (optional). DeepSeek key; leave empty to hide the partner. SPRECHEN_AI=off stops all calls at once.
DEEPSEEK_API_KEY=
# Model name, default deepseek-flash (the cheapest).
DEEPSEEK_MODEL=
SPRECHEN_AI=
